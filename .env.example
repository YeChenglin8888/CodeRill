# Copy this file to .env and fill in your own values.

# Required: an OpenAI-compatible API key.
OPENAI_API_KEY=sk-your-key-here

# Optional: point at any OpenAI-compatible endpoint (OpenAI, DeepSeek, Moonshot,
# a local vLLM server, ...). Leave unset to use the default OpenAI endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: which model to call.
# CODERILL_MODEL=gpt-4o-mini

# DeepSeek thinking mode: 1=enabled (default), 0=disabled.
CODERILL_THINKING_ENABLED=1

# Optional: generation limits and loop budget.
# CODERILL_MAX_TOKENS=4096
# CODERILL_TEMPERATURE=0
# CODERILL_MAX_TURNS=30
